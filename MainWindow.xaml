<ui:FluentWindow x:Class="OfiConvert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfiConvert"
        xmlns:vm="clr-namespace:OfiConvert.ViewModels"
        xmlns:models="clr-namespace:OfiConvert.Models"
        xmlns:converters="clr-namespace:OfiConvert.Converters"
        xmlns:behaviors="clr-namespace:OfiConvert.Behaviors"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}" 
        Height="800" Width="1050"
        MinHeight="700" MinWidth="800"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <ui:FluentWindow.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:FileIconConverter x:Key="FileIconConverter"/>
        <converters:StateToColorConverter x:Key="StateToColorConverter"/>
        <converters:StateToIconConverter x:Key="StateToIconConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ui:FluentWindow.Resources>

    <i:Interaction.Behaviors>
        <behaviors:FileDragDropBehavior ViewModel="{Binding}" HighlightBorder="{Binding ElementName=DropZone}"/>
    </i:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource AppTitle}"/>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="12,4,12,12">

            <!-- ==================== TAB: CONVERSION ==================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource TabConversion}"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Action Buttons -->
                    <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LblSelectFiles}" 
                                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                            <WrapPanel Orientation="Horizontal">
                                <ui:Button Content="{DynamicResource BtnSelectFile}"
                                           Appearance="Primary" Margin="0,0,8,4"
                                           IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}"
                                           Command="{Binding SelectFilesCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentAdd24"/></ui:Button.Icon>
                                </ui:Button>

                                <!-- Format Selector -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource LblFormat}" 
                                               VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                                    <ComboBox Width="110"
                                              SelectedValue="{Binding DefaultOutputFormat}"
                                              SelectedValuePath="Tag"
                                              IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}">
                                        <ComboBoxItem Content="PDF" Tag="{x:Static models:OutputFormat.PDF}"/>
                                        <ComboBoxItem Content="HTML" Tag="{x:Static models:OutputFormat.HTML}"/>
                                        <ComboBoxItem Content="CSV" Tag="{x:Static models:OutputFormat.CSV}"/>
                                        <ComboBoxItem Content="PNG" Tag="{x:Static models:OutputFormat.PNG}"/>
                                        <ComboBoxItem Content="JPG" Tag="{x:Static models:OutputFormat.JPG}"/>
                                    </ComboBox>
                                </StackPanel>

                                <ui:Button Content="{DynamicResource BtnConvert}"
                                           Appearance="Primary" Margin="0,0,8,4"
                                           IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}"
                                           Command="{Binding ConvertFilesCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24"/></ui:Button.Icon>
                                </ui:Button>

                                <ui:Button Content="{DynamicResource BtnPause}"
                                           Appearance="Caution" Margin="0,0,8,4"
                                           Visibility="{Binding IsConverting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Command="{Binding PauseConversionCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Pause24"/></ui:Button.Icon>
                                </ui:Button>

                                <ui:Button Content="{DynamicResource BtnResume}"
                                           Appearance="Success" Margin="0,0,8,4"
                                           Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Command="{Binding ResumeConversionCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Play24"/></ui:Button.Icon>
                                </ui:Button>

                                <ui:Button Content="{DynamicResource BtnCancel}"
                                           Appearance="Danger" Margin="0,0,8,4"
                                           Visibility="{Binding IsConverting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Command="{Binding CancelConversionCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24"/></ui:Button.Icon>
                                </ui:Button>

                                <ui:Button Content="{DynamicResource BtnClear}"
                                           Appearance="Secondary" Margin="0,0,0,4"
                                           IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}"
                                           Command="{Binding ClearFilesCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24"/></ui:Button.Icon>
                                </ui:Button>
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Output Folder Selection -->
                    <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LblOutputFolder}" 
                                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding OutputFolder, Mode=TwoWay}"
                                             IsReadOnly="True" Margin="0,0,8,0"
                                             VerticalAlignment="Center" Background="Transparent"/>
                                    <TextBlock Text="{DynamicResource LblDefaultFolder}"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutputFolder}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <ui:Button Grid.Column="1" Content="{DynamicResource BtnSelectFolder}"
                                           Margin="0,0,8,0"
                                           IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}"
                                           Command="{Binding SelectOutputFolderCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24"/></ui:Button.Icon>
                                </ui:Button>

                                <ui:Button Grid.Column="2" Appearance="Secondary"
                                           ToolTip="{DynamicResource TipDefaultFolder}"
                                           IsEnabled="{Binding UseCustomOutputFolder}"
                                           Command="{Binding ClearOutputFolderCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24"/></ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Files Header -->
                    <ui:Card Grid.Row="2" Margin="0,0,0,6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource LblDocumentsHeader}" 
                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource LblDragHint}" 
                                       FontSize="12" FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Files List -->
                    <Border Grid.Row="3" x:Name="DropZone"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="2" CornerRadius="8" Padding="2">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding FileCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="64" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource LblEmptyTitle}" 
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock Text="{DynamicResource LblEmptySubtitle}" 
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Files ListView -->
                            <ListView ItemsSource="{Binding SelectedFiles}"
                                      Background="Transparent" BorderThickness="0" Padding="8"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Thumbnail / File Icon -->
                                                <Grid Grid.Column="0" Width="42" Height="42" Margin="0,0,10,0"
                                                      VerticalAlignment="Center">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <ui:SymbolIcon Symbol="{Binding Extension, Converter={StaticResource FileIconConverter}}" 
                                                                   FontSize="24"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                </Grid>

                                                <!-- File Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Size}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text=" · " FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <TextBlock Text="{Binding Extension}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Per-file Format -->
                                                <ComboBox Grid.Column="2" Width="80" Margin="8,0"
                                                          VerticalAlignment="Center" FontSize="11"
                                                          ItemsSource="{Binding AvailableFormats}"
                                                          SelectedItem="{Binding Options.OutputFormat}"/>

                                                <!-- State Indicator -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" 
                                                           VerticalAlignment="Center" Margin="8,0" MinWidth="100">
                                                    <ui:SymbolIcon Symbol="{Binding State, Converter={StaticResource StateToIconConverter}}"
                                                                  Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                                                  FontSize="16" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding StateMessage}" FontSize="11" FontWeight="SemiBold"
                                                              Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                                              VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Retry Count -->
                                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="4,0"
                                                          FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          Text="{Binding RetryCount, StringFormat='↻ {0}'}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RetryCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Remove Button -->
                                                <ui:Button Grid.Column="5" Appearance="Secondary"
                                                           VerticalAlignment="Center" Padding="6"
                                                           Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                           CommandParameter="{Binding}">
                                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/></ui:Button.Icon>
                                                </ui:Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Progress Bar -->
                    <ui:Card Grid.Row="4" Margin="0,6,0,6" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Height="22" Minimum="0"
                                         Maximum="{Binding ProgressMaximum}"
                                         Value="{Binding ProgressValue}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </ui:Card>

                    <!-- Conversion Results -->
                    <ui:Card Grid.Row="5" Margin="0,0,0,6" Padding="14"
                             Visibility="{Binding ShowConversionResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessColorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasConversionErrors}" Value="True">
                                                    <Setter Property="Symbol" Value="Warning24"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningColorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>

                                <TextBlock Grid.Column="1" Text="{Binding ConversionResultTitle}"
                                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <ui:Button Grid.Column="2" Appearance="Secondary" Padding="6"
                                           ToolTip="{DynamicResource TipClose}"
                                           Command="{Binding CloseConversionResultsCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24"/></ui:Button.Icon>
                                </ui:Button>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding ConversionResultMessage}"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                            <Border Grid.Row="2"
                                    Visibility="{Binding HasConversionErrors, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource WarningColorBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10" MaxHeight="120">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LblErrorsDetected}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningColorBrush}" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding ConversionErrors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                              TextWrapping="Wrap" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </ui:Card>

                    <!-- Footer -->
                    <ui:Card Grid.Row="6" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource LblTotalSize}" 
                                           FontWeight="Medium" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TotalSize}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource LblFileCount}" 
                                           FontWeight="Medium" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding FileCount}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ==================== TAB: HISTORY ==================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource TabHistory}"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- History Actions -->
                    <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{DynamicResource BtnExportCsv}" Margin="0,0,8,0"
                                       Command="{Binding ExportHistoryCsvCommand}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24"/></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="{DynamicResource BtnExportTxt}" Margin="0,0,8,0"
                                       Command="{Binding ExportHistoryTxtCommand}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentText24"/></ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="{DynamicResource BtnClearHistory}" Appearance="Danger"
                                       Command="{Binding ClearHistoryCommand}">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24"/></ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </ui:Card>

                    <!-- History List -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4">
                        <Grid>
                            <!-- Empty History -->
                            <TextBlock Text="{DynamicResource LblNoHistory}" 
                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConversionHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListView ItemsSource="{Binding ConversionHistory}"
                                      Background="Transparent" BorderThickness="0" Padding="6"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Status Icon -->
                                                <ui:SymbolIcon Grid.Column="0" FontSize="20" Margin="0,0,10,0"
                                                               VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessColorBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                                    <Setter Property="Symbol" Value="ErrorCircle24"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorColorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>

                                                <!-- File Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SourceFileName}" FontWeight="Medium"
                                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text=" · " FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <TextBlock Text="{Binding Format}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                               Foreground="{DynamicResource ErrorColorBrush}" TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Duration -->
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0"
                                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding DurationSeconds, StringFormat='{}{0:F1}s'}"/>

                                                <!-- Output Path -->
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" MaxWidth="200"
                                                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding OutputPath}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== TAB: SETTINGS ==================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource TabSettings}"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel MaxWidth="750" HorizontalAlignment="Center">

                        <!-- Theme -->
                        <ui:Card Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource LblTheme}" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="160" VerticalAlignment="Center"
                                          SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="System">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Desktop24" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource LblThemeSystem}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Light">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource LblThemeLight}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Dark">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource LblThemeDark}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </ui:Card>

                        <!-- Language -->
                        <ui:Card Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource LblLanguage}" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="160" VerticalAlignment="Center"
                                          SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Español" Tag="es"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                    <ComboBoxItem Content="Português" Tag="pt"/>
                                    <ComboBoxItem Content="Français" Tag="fr"/>
                                    <ComboBoxItem Content="Deutsch" Tag="de"/>
                                    <ComboBoxItem Content="Italiano" Tag="it"/>
                                    <ComboBoxItem Content="中文" Tag="zh"/>
                                    <ComboBoxItem Content="日本語" Tag="ja"/>
                                </ComboBox>
                            </Grid>
                        </ui:Card>

                        <!-- Default Format -->
                        <ui:Card Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource LblDefaultFormat}" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center"
                                          SelectedValue="{Binding DefaultOutputFormat}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="PDF" Tag="{x:Static models:OutputFormat.PDF}"/>
                                    <ComboBoxItem Content="HTML" Tag="{x:Static models:OutputFormat.HTML}"/>
                                    <ComboBoxItem Content="CSV" Tag="{x:Static models:OutputFormat.CSV}"/>
                                    <ComboBoxItem Content="PNG" Tag="{x:Static models:OutputFormat.PNG}"/>
                                    <ComboBoxItem Content="JPG" Tag="{x:Static models:OutputFormat.JPG}"/>
                                </ComboBox>
                            </Grid>
                        </ui:Card>

                        <!-- Parallel Conversions -->
                        <ui:Card Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource LblParallelConversions}" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <ui:NumberBox Grid.Column="1" Width="100" VerticalAlignment="Center"
                                              Value="{Binding MaxParallelConversions}"
                                              Minimum="1" Maximum="8" SmallChange="1"
                                              SpinButtonPlacementMode="Inline"/>
                            </Grid>
                        </ui:Card>

                        <!-- Auto Retry -->
                        <ui:Card Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource LblAutoRetry}" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoRetryEnabled}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Visibility="{Binding AutoRetryEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource LblMaxRetries}" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ui:NumberBox Grid.Column="1" Width="100" VerticalAlignment="Center"
                                                  Value="{Binding MaxRetryCount}"
                                                  Minimum="1" Maximum="10" SmallChange="1"
                                                  SpinButtonPlacementMode="Inline"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Notifications -->
                        <ui:Card Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource LblShowNotifications}" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding ShowNotifications}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Minimize to Tray -->
                        <ui:Card Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource LblMinimizeToTray}" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding MinimizeToTray}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Context Menu -->
                        <ui:Card Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LblContextMenu}" FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{DynamicResource BtnRegisterMenu}" Margin="0,0,8,0"
                                               Appearance="Primary"
                                               IsEnabled="{Binding IsContextMenuRegistered, Converter={StaticResource InverseBoolConverter}}"
                                               Command="{Binding RegisterContextMenuCommand}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Add24"/></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="{DynamicResource BtnUnregisterMenu}"
                                               Appearance="Danger"
                                               IsEnabled="{Binding IsContextMenuRegistered}"
                                               Command="{Binding UnregisterContextMenuCommand}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Subtract24"/></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
