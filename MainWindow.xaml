<ui:FluentWindow x:Class="OfiConvert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfiConvert"
        xmlns:vm="clr-namespace:OfiConvert.ViewModels"
        xmlns:converters="clr-namespace:OfiConvert.Converters"
        xmlns:behaviors="clr-namespace:OfiConvert.Behaviors"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="OfiConvert - Convertidor de archivos Office a PDF" 
        Height="750" Width="950"
        MinHeight="650" MinWidth="750"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <ui:FluentWindow.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:FileIconConverter x:Key="FileIconConverter"/>
        <converters:StateToColorConverter x:Key="StateToColorConverter"/>
        <converters:StateToIconConverter x:Key="StateToIconConverter"/>
        
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ui:FluentWindow.Resources>

    <!-- Behavior para drag & drop en toda la ventana -->
    <i:Interaction.Behaviors>
        <behaviors:FileDragDropBehavior ViewModel="{Binding}" HighlightBorder="{Binding ElementName=DropZone}"/>
    </i:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <ui:TitleBar Grid.Column="0" 
                         Title="OfiConvert - Convertidor de archivos Office a PDF"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Action Buttons -->
            <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Selecciona:" 
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Margin="0,0,0,12"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Content="Archivo"
                                   Appearance="Primary"
                                   Margin="0,0,12,0"
                                   IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}"
                                   Command="{Binding SelectFilesCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DocumentAdd24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        
                        <ui:Button Content="Convertir"
                                   Appearance="Primary"
                                   Margin="0,0,12,0"
                                   IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}"
                                   Command="{Binding ConvertFilesCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24"/>
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button Content="Cancelar"
                                   Appearance="Danger"
                                   Margin="0,0,12,0"
                                   Visibility="{Binding IsConverting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Command="{Binding CancelConversionCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        
                        <ui:Button Content="Limpiar"
                                   Appearance="Secondary"
                                   IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}"
                                   Command="{Binding ClearFilesCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Output Folder Selection -->
            <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Carpeta de destino:" 
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBox Grid.Column="0" 
                                     Text="{Binding OutputFolder, Mode=TwoWay}"
                                     IsReadOnly="True"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Background="Transparent"/>
                            
                            <!-- Placeholder overlay cuando está vacío -->
                            <TextBlock Text="Misma ubicación que archivos originales"
                                      FontSize="12"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      IsHitTestVisible="False"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OutputFolder}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ui:Button Grid.Column="1"
                                   Content="Seleccionar"
                                   Margin="0,0,8,0"
                                   IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}"
                                   Command="{Binding SelectOutputFolderCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button Grid.Column="2"
                                   Appearance="Secondary"
                                   ToolTip="Usar ubicación predeterminada"
                                   IsEnabled="{Binding UseCustomOutputFolder}"
                                   Command="{Binding ClearOutputFolderCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Selected Files Header -->
            <ui:Card Grid.Row="2" Margin="0,0,0,8" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Documentos seleccionados" 
                               FontWeight="SemiBold" 
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" (Arrastra archivos aquí)" 
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </ui:Card>

            <!-- Files List with Drag & Drop -->
            <Border Grid.Row="3" 
                    x:Name="DropZone"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="2">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Visibility="{Binding FileCount, Converter={StaticResource CountToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="DocumentAdd24" 
                                       FontSize="64" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center"/>
                        <TextBlock Text="No hay archivos seleccionados" 
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Haz clic en 'Archivo' o arrastra archivos aquí" 
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Files ListView -->
                    <ListView ItemsSource="{Binding SelectedFiles}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="8"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- File Icon -->
                                        <ui:SymbolIcon Grid.Column="0" 
                                                       Symbol="{Binding Extension, Converter={StaticResource FileIconConverter}}" 
                                                       FontSize="24"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>

                                        <!-- File Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Medium"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Path}" 
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- File Size -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Size}" 
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0"/>

                                        <!-- State Indicator -->
                                        <StackPanel Grid.Column="3" 
                                                   Orientation="Horizontal" 
                                                   VerticalAlignment="Center"
                                                   Margin="12,0">
                                            <ui:SymbolIcon Symbol="{Binding State, Converter={StaticResource StateToIconConverter}}"
                                                          Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                                          FontSize="18"
                                                          Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding StateMessage}"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"
                                                      Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Remove Button -->
                                        <ui:Button Grid.Column="4"
                                                   Appearance="Secondary"
                                                   VerticalAlignment="Center"
                                                   Padding="8"
                                                   Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Dismiss24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Progress Bar -->
            <ui:Card Grid.Row="4" Margin="0,8,0,8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0" 
                                 Height="24"
                                 Minimum="0"
                                 Maximum="{Binding ProgressMaximum}"
                                 Value="{Binding ProgressValue}"
                                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" 
                               Text="{Binding ProgressPercentage}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>
            </ui:Card>

            <!-- Conversion Results Section -->
            <ui:Card Grid.Row="5" 
                     Margin="0,0,0,8" 
                     Padding="16"
                     Visibility="{Binding ShowConversionResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header with close button -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" 
                                       FontSize="24"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessColorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConversionErrors}" Value="True">
                                            <Setter Property="Symbol" Value="Warning24"/>
                                            <Setter Property="Foreground" Value="{DynamicResource WarningColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding ConversionResultTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <ui:Button Grid.Column="2"
                                   Appearance="Secondary"
                                   Padding="8"
                                   ToolTip="Cerrar"
                                   Command="{Binding CloseConversionResultsCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <!-- Summary Message -->
                    <TextBlock Grid.Row="1" 
                               Text="{Binding ConversionResultMessage}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <!-- Error List -->
                    <Border Grid.Row="2"
                            Visibility="{Binding HasConversionErrors, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource WarningColorBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Errores detectados:"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningColorBrush}"
                                           Margin="0,0,0,8"/>
                                
                                <ItemsControl ItemsSource="{Binding ConversionErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                      FontSize="11"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      TextWrapping="Wrap"
                                                      Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </ui:Card>

            <!-- Footer Info -->
            <ui:Card Grid.Row="6" Margin="0,0,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Tamaño Total:" 
                                   FontWeight="Medium" 
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalSize}" 
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Cantidad de archivos:" 
                                   FontWeight="Medium" 
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding FileCount}" 
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
