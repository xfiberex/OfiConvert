<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OfiConvert.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OfiConvert"
    xmlns:converters="using:OfiConvert.Converters"
    xmlns:helpers="using:OfiConvert.Helpers"
    Title="OfiConvert">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:FileIconConverter x:Key="FileIconConverter"/>
            <converters:StateToColorConverter x:Key="StateToColorConverter"/>
            <converters:StateToIconConverter x:Key="StateToIconConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:BoolToStatusIconConverter x:Key="BoolToStatusIconConverter"/>
            <converters:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter"/>
            <converters:DurationToTextConverter x:Key="DurationToTextConverter"/>
            <converters:ErrorsToResultIconConverter x:Key="ErrorsToResultIconConverter"/>
            <converters:ErrorsToResultColorConverter x:Key="ErrorsToResultColorConverter"/>
            <!-- Esto construye SU PROPIA instancia de LocalizationService: no es el singleton que usa el
                 código (LocalizationService.Instance). Funciona porque el idioma es ESTADO COMPARTIDO por
                 todas las instancias — ver LocalizationService, que documenta por qué tiene que serlo. -->
            <helpers:LocalizationService x:Key="Loc"/>
            <SolidColorBrush x:Key="SuccessColorBrush" Color="#10B981"/>
            <SolidColorBrush x:Key="WarningColorBrush" Color="#F59E0B"/>
            <SolidColorBrush x:Key="ErrorColorBrush" Color="#C42B1C"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock x:Name="TitleTextBlock"
                       Text="OfiConvert - Convertidor de archivos Office"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Update notification bar -->
            <InfoBar x:Name="infoBarUpdate"
                     Grid.Row="0"
                     IsOpen="False"
                     Severity="Informational"
                     IsClosable="True"
                     Margin="0,0,0,8">
                <InfoBar.Content>
                    <ProgressBar x:Name="pbUpdate"
                                 Visibility="Collapsed"
                                 Minimum="0" Maximum="1"
                                 IsIndeterminate="False"
                                 Margin="0,4,0,4" />
                </InfoBar.Content>
                <InfoBar.ActionButton>
                    <Button x:Name="btnInstalarUpdate"
                            Content="{Binding [BtnInstallUpdate], Source={StaticResource Loc}}"
                            Click="BtnDownloadUpdate_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Tab Navigation (Pivot) -->
            <!-- Los x:Name de los controles interactivos son su AutomationId: es como los encuentran los
                 UI tests (tests/OfiConvert.UiTests) y también los lectores de pantalla. No renombrarlos
                 sin actualizar los tests. -->
            <Pivot x:Name="pivotMain" Grid.Row="1">
                <!-- ==================== TAB: CONVERSION ==================== -->
                <PivotItem x:Name="tabConversion">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE895;" FontSize="16"/>
                            <TextBlock Text="{Binding [TabConversion], Source={StaticResource Loc}}"/>
                        </StackPanel>
                    </PivotItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Action Buttons -->
                            <Border Grid.Row="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding [LblSelectFiles], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                    <!-- Fila de acciones: origen a la IZQUIERDA (archivo + formato), acciones a la
                                         DERECHA (convertir + transitorios + limpiar). Antes iba todo pegado a la
                                         izquierda y sobraba medio ancho a la derecha. -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Origen: elegir archivo + formato de salida -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button x:Name="btnSelectFile"
                                                    Content="{Binding [BtnSelectFile], Source={StaticResource Loc}}"
                                                    IsEnabled="{Binding IsConverting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding SelectFilesCommand}"
                                                    MinWidth="100" Height="36">
                                                <Button.KeyboardAccelerators>
                                                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                                                </Button.KeyboardAccelerators>
                                            </Button>

                                            <TextBlock Text="{Binding [LblFormat], Source={StaticResource Loc}}"
                                                       VerticalAlignment="Center" FontSize="13"/>
                                            <!-- La etiqueta es el TextBlock de al lado, y UI Automation NO
                                                 los asocia: sin nombre propio, el Narrador anuncia "cuadro
                                                 combinado, PDF" sin decir de qué. Misma trampa que el
                                                 ToggleSwitch de más abajo (TJ-09). -->
                                            <ComboBox x:Name="cmbFormat" Width="110"
                                                      AutomationProperties.Name="{Binding [LblFormat], Source={StaticResource Loc}}"
                                                      SelectedIndex="0"
                                                      IsEnabled="{Binding IsConverting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                      SelectionChanged="CmbFormat_SelectionChanged">
                                                <ComboBoxItem Content="PDF" />
                                                <ComboBoxItem Content="HTML" />
                                                <ComboBoxItem Content="CSV" />
                                                <ComboBoxItem Content="PNG" />
                                                <ComboBoxItem Content="JPG" />
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Acciones: Convertir es la única de acento (una acción principal); los
                                             transitorios y Limpiar la acompañan. -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button x:Name="btnConvert"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Content="{Binding [BtnConvert], Source={StaticResource Loc}}"
                                                    IsEnabled="{Binding IsConverting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding ConvertFilesCommand}"
                                                    MinWidth="100" Height="36"/>

                                            <Button x:Name="btnPause"
                                                    Content="{Binding [BtnPause], Source={StaticResource Loc}}"
                                                    Visibility="{Binding IsConverting, Mode=OneWay}"
                                                    Command="{Binding PauseConversionCommand}"
                                                    Height="36"/>

                                            <Button x:Name="btnResume"
                                                    Content="{Binding [BtnResume], Source={StaticResource Loc}}"
                                                    Visibility="{Binding IsPaused, Mode=OneWay}"
                                                    Command="{Binding ResumeConversionCommand}"
                                                    Height="36"/>

                                            <!-- Destructivo OUTLINE: rojo en texto y borde, no relleno sólido. Así se lee
                                                 como destructivo con CUALQUIER acento del sistema (un relleno rojo choca
                                                 con acentos cálidos). Mismo criterio para Limpiar historial y Desregistrar. -->
                                            <Button x:Name="btnCancel"
                                                    Content="{Binding [BtnCancel], Source={StaticResource Loc}}"
                                                    Visibility="{Binding IsConverting, Mode=OneWay}"
                                                    Command="{Binding CancelConversionCommand}"
                                                    Height="36">
                                                <Button.Resources>
                                                    <ResourceDictionary>
                                                        <ResourceDictionary.ThemeDictionaries>
                                                            <ResourceDictionary x:Key="Light">
                                                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AC42B1C"/>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33C42B1C"/>
                                                                <SolidColorBrush x:Key="ButtonForeground" Color="#C42B1C"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#C42B1C"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C42B1C"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C42B1C"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C42B1C"/>
                                                            </ResourceDictionary>
                                                            <ResourceDictionary x:Key="Dark">
                                                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26E8776A"/>
                                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#40E8776A"/>
                                                                <SolidColorBrush x:Key="ButtonForeground" Color="#E8776A"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E8776A"/>
                                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E8776A"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E8776A"/>
                                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#E8776A"/>
                                                            </ResourceDictionary>
                                                        </ResourceDictionary.ThemeDictionaries>
                                                    </ResourceDictionary>
                                                </Button.Resources>
                                            </Button>

                                            <Button x:Name="btnClear"
                                                    Content="{Binding [BtnClear], Source={StaticResource Loc}}"
                                                    IsEnabled="{Binding IsConverting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding ClearFilesCommand}"
                                                    Height="36"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Output Folder Selection -->
                            <Border Grid.Row="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding [LblOutputFolder], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="txtOutputFolder"
                                                 Grid.Column="0"
                                                 Text="{Binding OutputFolder, Mode=TwoWay}"
                                                 IsReadOnly="True"
                                                 PlaceholderText="{Binding [LblDefaultFolder], Source={StaticResource Loc}}"
                                                 VerticalAlignment="Center"/>

                                        <Button x:Name="btnSelectFolder"
                                                Grid.Column="1"
                                                Content="{Binding [BtnSelectFolder], Source={StaticResource Loc}}"
                                                IsEnabled="{Binding IsConverting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                Command="{Binding SelectOutputFolderCommand}"
                                                Height="36"/>

                                        <!-- Botón SOLO icono: sin AutomationProperties.Name, un lector de
                                             pantalla anuncia "botón" y nada más. Se le da el mismo texto
                                             que su tooltip. -->
                                        <Button x:Name="btnClearOutputFolder"
                                                Grid.Column="2"
                                                IsEnabled="{Binding UseCustomOutputFolder, Mode=OneWay}"
                                                Command="{Binding ClearOutputFolderCommand}"
                                                AutomationProperties.Name="{Binding [TipDefaultFolder], Source={StaticResource Loc}}"
                                                ToolTipService.ToolTip="{Binding [TipDefaultFolder], Source={StaticResource Loc}}"
                                                Height="36">
                                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Files Header: es una ETIQUETA de la lista, no una tarjeta. Sin chrome (antes era
                                 otro rectángulo idéntico) se lee como el título de la zona de abajo. -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="4,4,4,0">
                                <TextBlock Text="{Binding [LblDocumentsHeader], Source={StaticResource Loc}}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [LblDragHint], Source={StaticResource Loc}}"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Files List / Drop Zone -->
                            <Border Grid.Row="3" x:Name="DropZone"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="2" CornerRadius="8" Padding="2"
                                    MinHeight="220">
                                <Grid>
                                    <!-- Empty State -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Spacing="8"
                                                Visibility="{Binding FileCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="48"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding [LblEmptyTitle], Source={StaticResource Loc}}"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding [LblEmptySubtitle], Source={StaticResource Loc}}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Files ListView -->
                                    <ListView x:Name="lvFiles"
                                              ItemsSource="{Binding SelectedFiles, Mode=OneWay}"
                                              SelectionMode="None"
                                              Padding="8">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,3">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Thumbnail / File Icon -->
                                                        <Grid Grid.Column="0" Width="42" Height="42"
                                                              VerticalAlignment="Center">
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                   Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                            <FontIcon Glyph="{Binding Extension, Converter={StaticResource FileIconConverter}}"
                                                                      FontSize="24"
                                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                      Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                        </Grid>

                                                        <!-- File Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding Size}" FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="&#xB7;" FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                                <TextBlock Text="{Binding Extension}" FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Per-file Format -->
                                                        <ComboBox Grid.Column="2" Width="80"
                                                                  AutomationProperties.Name="{Binding [LblFormat], Source={StaticResource Loc}}"
                                                                  VerticalAlignment="Center" FontSize="11"
                                                                  ItemsSource="{Binding AvailableFormats}"
                                                                  SelectedItem="{Binding Options.OutputFormat, Mode=TwoWay}"/>

                                                        <!-- State Indicator -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                   VerticalAlignment="Center" MinWidth="100" Spacing="4">
                                                            <FontIcon Glyph="{Binding State, Converter={StaticResource StateToIconConverter}}"
                                                                      Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                                                      FontSize="16"/>
                                                            <TextBlock Text="{Binding StateMessage}" FontSize="11" FontWeight="SemiBold"
                                                                      Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Retry Count -->
                                                        <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                                  FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  Visibility="{Binding RetryCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                                                            <Run Text="&#x21BB; "/><Run Text="{Binding RetryCount}"/>
                                                        </TextBlock>

                                                        <!-- Remove Button (solo icono: necesita nombre accesible) -->
                                                        <Button Grid.Column="5"
                                                                VerticalAlignment="Center" Padding="6"
                                                                Tag="{Binding}"
                                                                AutomationProperties.Name="{Binding [TipRemoveFile], Source={StaticResource Loc}}"
                                                                ToolTipService.ToolTip="{Binding [TipRemoveFile], Source={StaticResource Loc}}"
                                                                Click="BtnRemoveFile_Click">
                                                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- Progress Bar -->
                            <!-- La barra de progreso solo existe mientras se convierte: en reposo era una
                                 barra vacía con un "0%" al lado, ocupando sitio para no decir nada. -->
                            <Border Grid.Row="4"
                                    Visibility="{Binding IsConverting, Mode=OneWay}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Height="22" Minimum="0"
                                                 Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                                 Value="{Binding ProgressValue, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, Mode=OneWay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Conversion Results -->
                            <Border Grid.Row="5"
                                    Visibility="{Binding ShowConversionResults, Mode=OneWay}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- El icono refleja si hubo errores (antes: tilde verde FIJO, incluso en
                                             "finalizada con errores"). Ámbar de aviso, no rojo: parte del lote sí se convirtió. -->
                                        <FontIcon Grid.Column="0" x:Name="iconResult" FontSize="22" Margin="0,0,10,0"
                                                  Glyph="{Binding HasConversionErrors, Mode=OneWay, Converter={StaticResource ErrorsToResultIconConverter}}"
                                                  Foreground="{Binding HasConversionErrors, Mode=OneWay, Converter={StaticResource ErrorsToResultColorConverter}}"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding ConversionResultTitle, Mode=OneWay}"
                                                   FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <Button Grid.Column="2" Padding="6"
                                                AutomationProperties.Name="{Binding [TipClose], Source={StaticResource Loc}}"
                                                ToolTipService.ToolTip="{Binding [TipClose], Source={StaticResource Loc}}"
                                                Command="{Binding CloseConversionResultsCommand}">
                                            <FontIcon Glyph="&#xE711;"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{Binding ConversionResultMessage, Mode=OneWay}"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <Border Visibility="{Binding HasConversionErrors, Mode=OneWay}"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{StaticResource WarningColorBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10" MaxHeight="120">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding [LblErrorsDetected], Source={StaticResource Loc}}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WarningColorBrush}"/>
                                                <ItemsRepeater ItemsSource="{Binding ConversionErrors, Mode=OneWay}">
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{x:Bind}" FontSize="11"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                      TextWrapping="Wrap" Margin="0,2"/>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Footer: barra de resumen, no una tarjeta más. Fondo transparente y solo una línea
                                 divisoria arriba: recede en vez de competir con las tarjetas de acción. -->
                            <Border Grid.Row="6"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0" Padding="4,12,4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding [LblTotalSize], Source={StaticResource Loc}}"
                                                   FontWeight="Medium" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalSize, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding [LblFileCount], Source={StaticResource Loc}}"
                                                   FontWeight="Medium" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FileCount, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </PivotItem>

                <!-- ==================== TAB: HISTORY ==================== -->
                <PivotItem x:Name="tabHistory">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81C;" FontSize="16"/>
                            <TextBlock Text="{Binding [TabHistory], Source={StaticResource Loc}}"/>
                        </StackPanel>
                    </PivotItem.Header>

                    <Grid Padding="0,8,0,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- History Actions -->
                        <Border Grid.Row="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="btnExportCsv"
                                        Content="{Binding [BtnExportCsv], Source={StaticResource Loc}}"
                                        Command="{Binding ExportHistoryCsvCommand}" Height="36">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="E" Modifiers="Control"/>
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button x:Name="btnExportTxt"
                                        Content="{Binding [BtnExportTxt], Source={StaticResource Loc}}"
                                        Command="{Binding ExportHistoryTxtCommand}" Height="36"/>
                                <!-- Destructivo OUTLINE (ver btnCancel): rojo en texto y borde, no relleno. -->
                                <Button x:Name="btnClearHistory"
                                        Content="{Binding [BtnClearHistory], Source={StaticResource Loc}}"
                                        Command="{Binding ClearHistoryCommand}" Height="36">
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Light">
                                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AC42B1C"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33C42B1C"/>
                                                    <SolidColorBrush x:Key="ButtonForeground" Color="#C42B1C"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#C42B1C"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C42B1C"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C42B1C"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C42B1C"/>
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Dark">
                                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26E8776A"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#40E8776A"/>
                                                    <SolidColorBrush x:Key="ButtonForeground" Color="#E8776A"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E8776A"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E8776A"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E8776A"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#E8776A"/>
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- History List -->
                        <Border Grid.Row="1"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <Grid>
                                <!-- Estado vacío: mismo patrón que el de la pestaña de conversión (icono +
                                     título + subtítulo). Antes era una tarjeta enorme con una sola línea
                                     diminuta en el centro, que parecía sin terminar. -->
                                <StackPanel x:Name="txtNoHistory"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="8"
                                            Visibility="{Binding HistoryCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE81C;" FontSize="48"
                                              HorizontalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding [LblNoHistory], Source={StaticResource Loc}}"
                                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding [LblNoHistorySubtitle], Source={StaticResource Loc}}"
                                               FontSize="13" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <ListView x:Name="lvHistory"
                                          ItemsSource="{Binding ConversionHistory, Mode=OneWay}"
                                          SelectionMode="None"
                                          Padding="6">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,3">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Status Icon: refleja Success (antes: tilde verde FIJO
                                                         para todas las filas, incluidas las fallidas). -->
                                                    <FontIcon Grid.Column="0"
                                                              Glyph="{Binding Success, Converter={StaticResource BoolToStatusIconConverter}}"
                                                              Foreground="{Binding Success, Converter={StaticResource BoolToStatusColorConverter}}"
                                                              FontSize="20"
                                                              VerticalAlignment="Center"/>

                                                    <!-- File Info: nombre + metadata (fecha · formato · duración). La duración
                                                         vive aquí, con unidad, en vez de ser un número suelto en su columna. -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding SourceFileName}" FontWeight="Medium"
                                                                   FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding Timestamp}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="&#xB7;" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            <TextBlock Text="{Binding Format}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="&#xB7;" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            <TextBlock Text="{Binding DurationSeconds, Converter={StaticResource DurationToTextConverter}}"
                                                                       FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <!-- El motivo del fallo, solo en las filas que fallaron. Sin esto, un error
                                                             era indistinguible de un éxito (y su ruta de salida iba vacía). -->
                                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11"
                                                                   Foreground="{StaticResource ErrorColorBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding Success, Converter={StaticResource InverseBoolConverter}}"/>
                                                    </StackPanel>

                                                    <!-- Output Path: solo en filas con éxito (las fallidas no tienen ruta). Icono
                                                         de carpeta + ruta, alineado a la derecha, con más sitio que antes. -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center" MaxWidth="300"
                                                                HorizontalAlignment="Right"
                                                                Visibility="{Binding Success, Mode=OneWay}"
                                                                ToolTipService.ToolTip="{Binding OutputPath}">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="12"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  VerticalAlignment="Center"/>
                                                        <!-- MaxWidth en el TextBlock (no solo en el StackPanel): en un StackPanel
                                                             horizontal el hijo recibe ancho infinito y el TextTrimming no dispara,
                                                             así que la ruta se cortaba a hueso contra el borde, sin elipsis. -->
                                                        <TextBlock Text="{Binding OutputPath}" FontSize="11" MaxWidth="260"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </PivotItem>

                <!-- ==================== TAB: SETTINGS ==================== -->
                <PivotItem x:Name="tabSettings">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="16"/>
                            <TextBlock Text="{Binding [TabSettings], Source={StaticResource Loc}}"/>
                        </StackPanel>
                    </PivotItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                        <StackPanel Spacing="10" MaxWidth="750" HorizontalAlignment="Center">

                            <!-- Ajustes era una lista plana de 8 tarjetas: con tres cabeceras se lee de un
                                 vistazo dónde está cada cosa. -->
                            <TextBlock Text="{Binding [LblGroupAppearance], Source={StaticResource Loc}}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="4,4,0,0"/>

                            <!-- Theme -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [LblTheme], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbTheme" Grid.Column="1" Width="160"
                                              AutomationProperties.Name="{Binding [LblTheme], Source={StaticResource Loc}}"
                                              VerticalAlignment="Center"
                                              SelectionChanged="CmbTheme_SelectionChanged">
                                        <ComboBoxItem Content="{Binding [LblThemeSystem], Source={StaticResource Loc}}" Tag="System"/>
                                        <ComboBoxItem Content="{Binding [LblThemeLight], Source={StaticResource Loc}}" Tag="Light"/>
                                        <ComboBoxItem Content="{Binding [LblThemeDark], Source={StaticResource Loc}}" Tag="Dark"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Language -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [LblLanguage], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbLanguage" Grid.Column="1" Width="160"
                                              AutomationProperties.Name="{Binding [LblLanguage], Source={StaticResource Loc}}"
                                              VerticalAlignment="Center"
                                              SelectionChanged="CmbLanguage_SelectionChanged">
                                        <ComboBoxItem Content="Espa&#xF1;ol" Tag="es"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="Portugu&#xEA;s" Tag="pt"/>
                                        <ComboBoxItem Content="Fran&#xE7;ais" Tag="fr"/>
                                        <ComboBoxItem Content="Deutsch" Tag="de"/>
                                        <ComboBoxItem Content="Italiano" Tag="it"/>
                                        <ComboBoxItem Content="&#x4E2D;&#x6587;" Tag="zh"/>
                                        <ComboBoxItem Content="&#x65E5;&#x672C;&#x8A9E;" Tag="ja"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding [LblGroupConversion], Source={StaticResource Loc}}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="4,12,0,0"/>

                            <!-- Default Format -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [LblDefaultFormat], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbDefaultFormat" Grid.Column="1" Width="140"
                                              AutomationProperties.Name="{Binding [LblDefaultFormat], Source={StaticResource Loc}}"
                                              VerticalAlignment="Center"
                                              SelectionChanged="CmbDefaultFormat_SelectionChanged">
                                        <ComboBoxItem Content="PDF"/>
                                        <ComboBoxItem Content="HTML"/>
                                        <ComboBoxItem Content="CSV"/>
                                        <ComboBoxItem Content="PNG"/>
                                        <ComboBoxItem Content="JPG"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Parallel Conversions -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [LblParallelConversions], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                    <NumberBox x:Name="nbParallel" Grid.Column="1" Width="100"
                                              AutomationProperties.Name="{Binding [LblParallelConversions], Source={StaticResource Loc}}"
                                              VerticalAlignment="Center"
                                              Value="{Binding MaxParallelConversions, Mode=TwoWay}"
                                              Minimum="1" Maximum="8" SmallChange="1"
                                              SpinButtonPlacementMode="Inline"/>
                                </Grid>
                            </Border>

                            <!-- Auto Retry -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [LblAutoRetry], Source={StaticResource Loc}}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                        <!-- Un ToggleSwitch se expone a UI Automation como un botón SIN nombre:
                                             su etiqueta es un TextBlock aparte, que el lector de pantalla no
                                             asocia. Sin esto anuncia "botón, activado" sin decir de qué. -->
                                        <ToggleSwitch x:Name="tsAutoRetry" Grid.Column="1"
                                                      AutomationProperties.Name="{Binding [LblAutoRetry], Source={StaticResource Loc}}"
                                                      IsOn="{Binding AutoRetryEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Visibility="{Binding AutoRetryEnabled, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [LblMaxRetries], Source={StaticResource Loc}}" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <NumberBox Grid.Column="1" Width="100" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding [LblMaxRetries], Source={StaticResource Loc}}"
                                                  Value="{Binding MaxRetryCount, Mode=TwoWay}"
                                                  Minimum="1" Maximum="10" SmallChange="1"
                                                  SpinButtonPlacementMode="Inline"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Notifications -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [LblShowNotifications], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="tsShowNotifications" Grid.Column="1"
                                                  AutomationProperties.Name="{Binding [LblShowNotifications], Source={StaticResource Loc}}"
                                                  IsOn="{Binding ShowNotifications, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Minimize to Tray -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [LblMinimizeToTray], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="tsMinimizeToTray" Grid.Column="1"
                                                  AutomationProperties.Name="{Binding [LblMinimizeToTray], Source={StaticResource Loc}}"
                                                  IsOn="{Binding MinimizeToTray, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding [LblGroupIntegration], Source={StaticResource Loc}}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="4,12,0,0"/>

                            <!-- Context Menu -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding [LblContextMenu], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{StaticResource AccentButtonStyle}"
                                                Content="{Binding [BtnRegisterMenu], Source={StaticResource Loc}}"
                                                IsEnabled="{Binding IsContextMenuRegistered, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                Command="{Binding RegisterContextMenuCommand}"
                                                Height="36"/>
                                        <!-- Destructivo OUTLINE (ver btnCancel): junto a "Registrar" (acento), un
                                             relleno rojo se confundía con el acento en sistemas de acento cálido. -->
                                        <Button Content="{Binding [BtnUnregisterMenu], Source={StaticResource Loc}}"
                                                IsEnabled="{Binding IsContextMenuRegistered, Mode=OneWay}"
                                                Command="{Binding UnregisterContextMenuCommand}"
                                                Height="36">
                                            <Button.Resources>
                                                <ResourceDictionary>
                                                    <ResourceDictionary.ThemeDictionaries>
                                                        <ResourceDictionary x:Key="Light">
                                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AC42B1C"/>
                                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33C42B1C"/>
                                                            <SolidColorBrush x:Key="ButtonForeground" Color="#C42B1C"/>
                                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#C42B1C"/>
                                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C42B1C"/>
                                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C42B1C"/>
                                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C42B1C"/>
                                                        </ResourceDictionary>
                                                        <ResourceDictionary x:Key="Dark">
                                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26E8776A"/>
                                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#40E8776A"/>
                                                            <SolidColorBrush x:Key="ButtonForeground" Color="#E8776A"/>
                                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E8776A"/>
                                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E8776A"/>
                                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E8776A"/>
                                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#E8776A"/>
                                                        </ResourceDictionary>
                                                    </ResourceDictionary.ThemeDictionaries>
                                                </ResourceDictionary>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Check for updates -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [LblCheckUpdates], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                    <Button x:Name="btnBuscarActualizacion" Grid.Column="1"
                                            Content="{Binding [BtnCheckUpdate], Source={StaticResource Loc}}"
                                            Click="BtnBuscarActualizacion_Click" Height="36"/>
                                </Grid>
                            </Border>

                            <!-- Acerca de: versión + los textos legales EMBEBIDOS en el .exe (Core/LegalText).
                                 Las licencias de los componentes redistribuidos obligan a mostrar su
                                 atribución; esta es la única vía por la que el usuario llega a ella. -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding [LblAbout], Source={StaticResource Loc}}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                    <TextBlock x:Name="txtAboutVersion"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextSelectionEnabled="True"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="btnLicencia"
                                                Content="{Binding [BtnLicense], Source={StaticResource Loc}}"
                                                Click="BtnLicencia_Click" Height="36"/>
                                        <Button x:Name="btnAvisosTerceros"
                                                Content="{Binding [BtnThirdParty], Source={StaticResource Loc}}"
                                                Click="BtnAvisosTerceros_Click" Height="36"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Window>


