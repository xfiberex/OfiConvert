<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SignAssembly>false</SignAssembly>
    <Copyright>Ricky Angel Jimenez Bueno</Copyright>
    <Description>Convertidor por lotes de documentos Office (Word, Excel, PowerPoint) a PDF, HTML, CSV, PNG y JPG</Description>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <AssemblyTitle>OfiConvert</AssemblyTitle>
    <Product>OfiConvert</Product>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- El .csproj de la app vive en la RAÍZ del repo, así que su glob por defecto (**/*.cs) se traga
         también el proyecto de pruebas de tests\. Sin esto, la app intenta compilar los archivos de
         test (que no referencian xUnit) y el build revienta con errores que no tienen nada que ver. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude Lang files from XAML compilation (they are parsed manually by LocalizationService) -->
    <None Remove="Lang\**\*.xaml" />
    <Page Remove="Lang\**\*.xaml;publish\**\*.xaml" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Lang\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
  </ItemGroup>

  <!-- Copy .xbf and .pri to publish output (WinUI 3 unpackaged workaround) -->
  <Target Name="CopyXamlResourcesToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_BuildOutput>$(OutputPath)</_BuildOutput>
    </PropertyGroup>
    <ItemGroup>
      <_XbfFiles Include="$(_BuildOutput)**\*.xbf" />
      <_AppPri Include="$(_BuildOutput)OfiConvert.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_XbfFiles)" DestinationFiles="@(_XbfFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy Lang files to publish output (CopyToPublishDirectory is filtered by WinUI 3 tooling) -->
  <Target Name="CopyLangFilesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_LangFiles Include="$(MSBuildProjectDirectory)\Lang\*.xaml" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)Lang" />
    <Copy SourceFiles="@(_LangFiles)" DestinationFolder="$(PublishDir)Lang" SkipUnchangedFiles="true" />
  </Target>

</Project>
