    <system:String x:Key="TipSheetNames">用逗号分隔的工作表名称</system:String>
    <system:String x:Key="TipSlideRange">例如：1-10 或 1,3,5</system:String>

    <!-- States -->
    <system:String x:Key="StatePending">待处理</system:String>
    <system:String x:Key="StateValidating">验证中...</system:String>
    <system:String x:Key="StateConverting">转换中...</system:String>
    <system:String x:Key="StateRetrying">重试中...</system:String>
    <system:String x:Key="StatePaused">已暂停</system:String>
    <system:String x:Key="StateCompleted">已完成</system:String>
