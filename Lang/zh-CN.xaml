    <system:String x:Key="StateSkipped">已跳过</system:String>
    <system:String x:Key="StateCancelled">已取消</system:String>

    <!-- Settings -->
    <system:String x:Key="LblTheme">主题：</system:String>
    <system:String x:Key="LblThemeSystem">系统</system:String>
    <system:String x:Key="LblThemeDark">深色</system:String>
    <system:String x:Key="LblThemeLight">浅色</system:String>
    <system:String x:Key="LblLanguage">语言：</system:String>
    <system:String x:Key="LblSpanish">Español</system:String>
    <system:String x:Key="LblEnglish">English</system:String>
    <system:String x:Key="LblPortuguese">Português</system:String>
    <system:String x:Key="LblFrench">Français</system:String>
    <system:String x:Key="LblGerman">Deutsch</system:String>
    <system:String x:Key="LblItalian">Italiano</system:String>
