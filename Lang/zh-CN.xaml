<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- App -->
    <system:String x:Key="AppTitle">OfiConvert - Office 文件转换器</system:String>

    <!-- Tabs -->
    <system:String x:Key="TabConversion">转换</system:String>
    <system:String x:Key="TabHistory">历史记录</system:String>
    <system:String x:Key="TabSettings">设置</system:String>

    <!-- Action Buttons -->
    <system:String x:Key="BtnSelectFile">文件</system:String>
    <system:String x:Key="BtnConvert">转换</system:String>
    <system:String x:Key="BtnCancel">取消</system:String>
    <system:String x:Key="BtnPause">暂停</system:String>
    <system:String x:Key="BtnResume">继续</system:String>
    <system:String x:Key="BtnClear">清除</system:String>
    <system:String x:Key="BtnExport">导出</system:String>
    <system:String x:Key="BtnYes">是</system:String>
    <system:String x:Key="BtnNo">否</system:String>

    <!-- Labels -->
    <system:String x:Key="LblSelectFiles">文件和格式</system:String>
    <system:String x:Key="LblFormat">格式：</system:String>
    <system:String x:Key="LblOutputFolder">输出文件夹：</system:String>
    <system:String x:Key="LblDefaultFolder">与原始文件相同的位置</system:String>
    <system:String x:Key="BtnSelectFolder">选择</system:String>
    <system:String x:Key="TipDefaultFolder">使用默认位置</system:String>
    <system:String x:Key="LblDocumentsHeader">已选择的文档</system:String>
    <system:String x:Key="LblDragHint"> （拖放文件到此处）</system:String>
    <system:String x:Key="LblEmptyTitle">未选择文件</system:String>
    <system:String x:Key="LblEmptySubtitle">点击"文件"或将文件拖放到此处</system:String>
    <system:String x:Key="LblTotalSize">总大小：</system:String>
    <system:String x:Key="LblFileCount">文件数量：</system:String>
    <system:String x:Key="LblErrorsDetected">检测到错误：</system:String>
    <system:String x:Key="TipClose">关闭</system:String>

    <!-- Per-file options -->
    <system:String x:Key="LblPageRange">页面范围：</system:String>
    <system:String x:Key="LblSheetNames">工作表（名称）：</system:String>
    <system:String x:Key="LblSlideRange">幻灯片范围：</system:String>
