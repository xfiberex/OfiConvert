    <system:String x:Key="TrayShow">显示</system:String>
    <system:String x:Key="TrayStartConversion">开始转换</system:String>
    <system:String x:Key="TrayExit">退出</system:String>
    <system:String x:Key="TrayNotifSuccess">转换完成：已转换 {0} 个文件。</system:String>
    <system:String x:Key="TrayNotifErrors">转换完成：{0} 个成功，{1} 个有错误。</system:String>

    <!-- Messages -->
    <system:String x:Key="MsgFileTooBig">文件 '{0}' 超过 500 MB 限制，将不会被添加。</system:String>
    <system:String x:Key="MsgOfficeNotFound">未安装 Microsoft Office 或无法访问。

此应用程序需要系统上安装 Microsoft Office（Word、Excel 和/或 PowerPoint）才能将文件转换为 PDF。

如果可用，将尝试使用 LibreOffice 作为替代方案。</system:String>
    <system:String x:Key="MsgConversionSuccess">转换成功</system:String>
    <system:String x:Key="MsgConversionErrors">转换完成但有错误</system:String>
    <system:String x:Key="MsgFilesConverted">已成功转换 {0} 个文件。</system:String>
    <system:String x:Key="MsgFilesFailed">{0} 个文件失败。</system:String>
    <system:String x:Key="MsgFilesSavedTo">文件已保存到：{0}</system:String>
    <system:String x:Key="MsgCancelConfirm">正在进行转换。如果现在关闭，Office 进程可能会保持打开状态。

是否要取消转换并退出？</system:String>
    <system:String x:Key="MsgCancelConfirmTitle">确认关闭</system:String>
    <system:String x:Key="MsgConversionComplete">转换完成！</system:String>
    <system:String x:Key="MsgPasswordProtected">文件受密码保护。</system:String>
    <system:String x:Key="MsgCorruptFile">文件似乎已损坏。</system:String>
    <system:String x:Key="MsgFileLocked">文件被其他进程锁定。</system:String>
    <system:String x:Key="MsgFileNotFound">文件不存在。</system:String>
    <system:String x:Key="MsgLibreOfficeFallback">正在使用 LibreOffice 作为替代方案...</system:String>
    <system:String x:Key="MsgNoConverterAvailable">没有可用的转换引擎。请安装 Microsoft Office 或 LibreOffice。</system:String>
    <system:String x:Key="MsgWarning">警告</system:String>
    <system:String x:Key="MsgInfo">信息</system:String>
    <system:String x:Key="MsgError">错误</system:String>
    <system:String x:Key="MsgConfirmation">确认</system:String>
    <system:String x:Key="MsgContextMenuRegistered">右键菜单注册成功。</system:String>
    <system:String x:Key="MsgContextMenuUnregistered">右键菜单已取消注册。</system:String>

    <!-- Filter -->
    <system:String x:Key="FilterOfficeFiles">Office 文件|*.doc;*.docx;*.xls;*.xlsx;*.ppt;*.pptx|Word 文件 (*.docx)|*.docx|Excel 文件 (*.xlsx)|*.xlsx|PowerPoint 文件 (*.pptx)|*.pptx|所有文件|*.*</system:String>
    <system:String x:Key="FilterCsv">CSV 文件|*.csv</system:String>
    <system:String x:Key="FilterTxt">文本文件|*.txt</system:String>
    <system:String x:Key="TitleSelectFiles">选择 Office 文件</system:String>
    <system:String x:Key="TitleSelectOutputFolder">选择转换文件的输出文件夹</system:String>


    <!-- About / legal -->
    <system:String x:Key="LblAbout">关于</system:String>
    <system:String x:Key="BtnLicense">许可证</system:String>
    <system:String x:Key="BtnThirdParty">第三方声明</system:String>
    <system:String x:Key="MsgLegalUnavailable">文本不可用。</system:String>


    <!-- Tier G: UI/UX -->
    <system:String x:Key="MsgClearHistoryConfirm">将删除所有历史记录。此操作无法撤消。

是否继续？</system:String>
    <system:String x:Key="MsgClearHistoryConfirmTitle">清除历史记录</system:String>
    <system:String x:Key="TipRemoveFile">从列表中移除</system:String>
    <system:String x:Key="LblNoHistorySubtitle">您进行的转换将显示在此处</system:String>
    <system:String x:Key="LblGroupAppearance">外观</system:String>
    <system:String x:Key="LblGroupConversion">转换</system:String>
    <system:String x:Key="LblGroupIntegration">集成与更新</system:String>


    <!-- Tier H: instalador y diálogos -->
    <system:String x:Key="BtnInstallUpdate">立即安装</system:String>
    <system:String x:Key="BtnOk">确定</system:String>
    <system:String x:Key="MsgInformation">信息</system:String>
    <system:String x:Key="MsgDownloading">正在下载... {0}</system:String>
    <system:String x:Key="MsgInstalling">正在安装... 应用程序将自动重启。</system:String>
    <system:String x:Key="MsgUpdateElevationDenied">更新已取消：未授予管理员权限。应用程序将继续使用当前版本。</system:String>
    <system:String x:Key="MsgUpdateInstallFailed">无法安装更新（代码 {0}）。请从 GitHub 手动下载。</system:String>

    <system:String x:Key="MsgCheckingUpdate">正在检查...</system:String>

</ResourceDictionary>
