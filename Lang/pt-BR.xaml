<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- App -->
    <system:String x:Key="AppTitle">OfiConvert - Conversor de arquivos Office</system:String>

    <!-- Tabs -->
    <system:String x:Key="TabConversion">Conversão</system:String>
    <system:String x:Key="TabHistory">Histórico</system:String>
    <system:String x:Key="TabSettings">Configurações</system:String>

    <!-- Action Buttons -->
    <system:String x:Key="BtnSelectFile">Arquivo</system:String>
    <system:String x:Key="BtnConvert">Converter</system:String>
    <system:String x:Key="BtnCancel">Cancelar</system:String>
    <system:String x:Key="BtnPause">Pausar</system:String>
    <system:String x:Key="BtnResume">Retomar</system:String>
    <system:String x:Key="BtnClear">Limpar</system:String>
    <system:String x:Key="BtnExport">Exportar</system:String>

    <!-- Labels -->
    <system:String x:Key="LblSelectFiles">Selecionar:</system:String>
    <system:String x:Key="LblFormat">Formato:</system:String>
    <system:String x:Key="LblOutputFolder">Pasta de destino:</system:String>
