    <system:String x:Key="MsgUpdateAvailable">Abrir a página de download?</system:String>

    <!-- History -->
    <system:String x:Key="BtnExportCsv">Exportar CSV</system:String>
    <system:String x:Key="BtnExportTxt">Exportar TXT</system:String>
