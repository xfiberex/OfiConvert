Deseja cancelar a conversão e sair?</system:String>
    <system:String x:Key="MsgCancelConfirmTitle">Confirmar fechamento</system:String>
    <system:String x:Key="MsgCannotClearConverting">Não é possível limpar durante a conversão.</system:String>
    <system:String x:Key="MsgNoFilesToClear">Nenhum arquivo para limpar.</system:String>
    <system:String x:Key="MsgConversionComplete">Conversão concluída!</system:String>
    <system:String x:Key="MsgPasswordProtected">O arquivo está protegido por senha.</system:String>
    <system:String x:Key="MsgCorruptFile">O arquivo parece estar corrompido.</system:String>
    <system:String x:Key="MsgFileLocked">O arquivo está bloqueado por outro processo.</system:String>
    <system:String x:Key="MsgFileNotFound">O arquivo não existe.</system:String>
    <system:String x:Key="MsgLibreOfficeFallback">Usando o LibreOffice como alternativa...</system:String>
    <system:String x:Key="MsgNoConverterAvailable">Nenhum mecanismo de conversão disponível. Instale o Microsoft Office ou o LibreOffice.</system:String>
    <system:String x:Key="MsgWarning">Aviso</system:String>
    <system:String x:Key="MsgInfo">Informação</system:String>
    <system:String x:Key="MsgError">Erro</system:String>
    <system:String x:Key="MsgConfirmation">Confirmação</system:String>
