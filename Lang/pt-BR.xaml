    <system:String x:Key="FilterOfficeFiles">Arquivos Office|*.doc;*.docx;*.xls;*.xlsx;*.ppt;*.pptx|Arquivos Word (*.docx)|*.docx|Arquivos Excel (*.xlsx)|*.xlsx|Arquivos PowerPoint (*.pptx)|*.pptx|Todos os arquivos|*.*</system:String>
    <system:String x:Key="FilterCsv">Arquivo CSV|*.csv</system:String>
    <system:String x:Key="FilterTxt">Arquivo de texto|*.txt</system:String>
    <system:String x:Key="TitleSelectFiles">Selecionar arquivos do Office</system:String>
    <system:String x:Key="TitleSelectOutputFolder">Selecionar pasta de destino para arquivos convertidos</system:String>

