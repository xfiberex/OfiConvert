  </ItemGroup>

  <!-- La app es `internal` de puertas afuera: AssemblyInfo.cs le abre los internals a este proyecto. -->
  <ItemGroup>
    <ProjectReference Include="..\..\OfiConvert.csproj" />
  </ItemGroup>

</Project>
